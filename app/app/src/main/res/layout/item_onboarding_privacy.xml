<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="24dp">

        <ImageView
            android:id="@+id/pageImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_info"
            android:scaleType="centerInside"
            android:layout_gravity="center"
            app:tint="@color/primary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="隐私协议"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_gravity="center"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/pageSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请仔细阅读以下内容"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/privacySection1Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 信息收集"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/privacySection1Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="我们仅收集您使用 App 时必要的信息，包括：\n• 您拍摄或选择的图片（仅本地存储，除非您主动同意上传）\n• 识别记录和收藏信息\n• 基本使用统计数据（匿名）"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/privacySection2Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. 信息使用"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/privacySection2Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="收集的信息仅用于：\n• 提供果蔬识别功能\n• 保存您的识别历史\n• 改进 App 体验\n我们绝不会将您的个人信息出售给第三方"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/privacySection3Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. 权限说明"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/privacySection3Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="我们申请的权限说明：\n• 相机权限：用于拍照识别果蔬\n• 存储权限：用于保存识别记录和图片\n您可以随时在系统设置中管理这些权限"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/privacySection4Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. 您的权利"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/privacySection4Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="您拥有以下权利：\n• 查看和删除您的识别记录\n• 导出您的个人数据\n• 注销账号（如适用）\n如有任何问题，请通过 App 内反馈渠道联系我们"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/privacyFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击同意并继续即表示您已阅读并同意以上隐私协议"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

</ScrollView>
